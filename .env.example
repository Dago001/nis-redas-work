APP_NAME="NIS REDAS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nis_redas
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nis.gov.ng"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# JWT configuration (production MUST set a strong secret >= 32 bytes; base64:<value> supported)
JWT_SECRET=
JWT_PREVIOUS_SECRETS=
JWT_ISSUER=nis-redas
JWT_AUDIENCE=nis-redas-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# API OTP challenge configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_INTERVAL=30
OTP_DIGITS=6

# Geolocation ABAC configuration (HTTPS only)
GEOLOCATION_PROVIDER=ipapi_co
GEOLOCATION_API_TOKEN=
GEOLOCATION_TIMEOUT=3
GEOLOCATION_RETRIES=1
GEOLOCATION_RETRY_SLEEP_MS=200
GEOLOCATION_CACHE_TTL=1440
GEOLOCATION_ALLOW_PRIVATE_FALLBACK=false
GEOLOCATION_UNKNOWN_POLICY=deny

# Comma-separated trusted reverse proxy IPs/CIDRs (empty trusts no proxy headers)
TRUSTED_PROXIES=

# Audit logging
AUDIT_LOG_CHANNEL=audit
AUDIT_RETENTION_DAYS=2555
AUDIT_AUTO_PRUNE=false

# File storage and optional malware scanner (none | clamav)
MALWARE_SCANNER=none
CLAMAV_SOCKET=
ARCHIVE_RETENTION_DAYS=2555

VITE_APP_NAME="${APP_NAME}"
